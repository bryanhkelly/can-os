    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "playwright": "^1.56.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "vitest": "^5.0.4"
