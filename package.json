    "db:studio": "drizzle-kit studio",
    "demo:provision-registrar": "node --import tsx scripts/provision-demo-registrar.mjs",
    "test": "vitest run --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "typecheck": "tsc --noEmit",
    "test:integration:study-groups": "node scripts/run-integration-tests.mjs study-groups",
    "test:integration:study-group-lifecycle": "node scripts/run-integration-tests.mjs study-group-lifecycle",
    "test:integration:admissions": "node scripts/run-integration-tests.mjs admissions-offers",
