    "test:e2e:admissions": "node scripts/run-admissions-e2e.mjs",
    "test:e2e:full-flow": "node scripts/run-fullflow-e2e.mjs",
    "test:integration:academic-intervention": "node scripts/run-integration-tests.mjs academic-intervention",
    "test:e2e:curriculum": "playwright test --config playwright.curriculum.config.ts",
    "test:integration:curriculum-journey": "node scripts/run-integration-tests.mjs curriculum-journey",
    "test:integration:network-onboarding": "node scripts/run-integration-tests.mjs network-onboarding",
    "test:integration:full-flow": "node scripts/run-integration-tests.mjs full-flow",
    "test:integration:journey-c": "node scripts/run-integration-tests.mjs journey-c",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:visual": "npm run build-storybook && chromatic",
    "lint": "eslint . && node scripts/check-design-system.mjs",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
