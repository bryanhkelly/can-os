# Neon pooled connection string.
# Example:
# DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Identifies this deployment in audit/event metadata.
APP_ENV=development

# Disposable isolated Neon branch only. Never use the application database.
TEST_DATABASE_URL=
CAN_TEST_DB_WRITES_ENABLED=false

# Explicit local/test operator provisioning only; demo sign-in needs no flag.
CAN_DEMO_FIXED_ACCESS_ENABLED=false

# Private Cloudflare R2 school documents (server-side only).
# Keep upload toggles disabled until bucket CORS, access controls, file review,
# retention and malware scanning policies have been approved.
CAN_R2_ACCOUNT_ID=
CAN_R2_BUCKET=
CAN_R2_ACCESS_KEY_ID=
CAN_R2_SECRET_ACCESS_KEY=
CAN_R2_DEMO_UPLOADS_ENABLED=false
CAN_R2_LIVE_UPLOADS_ENABLED=false
