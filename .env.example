# Neon pooled connection string.
# Example:
# DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Identifies this deployment in audit/event metadata.
APP_ENV=development

# Disposable isolated Neon branch only. Never use the application database.
TEST_DATABASE_URL=
CAN_TEST_DB_WRITES_ENABLED=false

# Separate restricted login to the SAME isolated canonical test database.
# Only for database role and Blueprint acceptance checks. Never a production URL.
CAN_CANONICAL_TEST_APP_DATABASE_URL=

# Explicit local/test operator provisioning only; demo sign-in needs no flag.
CAN_DEMO_FIXED_ACCESS_ENABLED=false

# Canonical Blueprint library and program discovery for authorized Sites only.
# Keep disabled until canonical Sites, PostgreSQL catalog roles and grants are provisioned.
CAN_CANONICAL_CATALOG_ENABLED=false

# Native CAN OS v3 session pepper (min 32 random characters). Independent of
# the previous app's auth configuration; never commit a real value.
CAN_CANONICAL_ACCESS_TOKEN_PEPPER=

# Dedicated Neon LOGIN role can_os_canonical_auth_app. This connection must NOT
# be DATABASE_URL or a Neon owner. The role may SET the restricted
# can_v30_canonical_auth_reader to call only the verified session function.
CAN_CANONICAL_AUTH_DATABASE_URL=

# Separate secret for short-lived facilitator pairing codes (min 32 chars).
CAN_FACILITATED_PAIRING_PEPPER=

# Learning sessions and facilitated delivery are regular CAN OS capabilities.
# There are no rollout flags. Production requires the dedicated restricted
# canonical auth connection and the two strong secrets above; missing credentials
# deny protected API operations without using a privileged database fallback.

# Canonical public Site claims; enable only after schema and reader role are deployed.
CAN_PUBLIC_SITE_CANONICAL_ENABLED=false

# Private Cloudflare R2 school documents (server-side only).
# Keep upload toggles disabled until bucket CORS, access controls, file review,
# retention and malware scanning policies have been approved.
CAN_R2_ACCOUNT_ID=
CAN_R2_BUCKET=
CAN_R2_ACCESS_KEY_ID=
CAN_R2_SECRET_ACCESS_KEY=
CAN_R2_DEMO_UPLOADS_ENABLED=false
CAN_R2_LIVE_UPLOADS_ENABLED=false

# Optional canonical Course knowledge-check drafting: disabled until the
# isolated QA database has the scoped NOLOGIN assessment author role and
# audited stored command. Key is server-only AES-256-GCM, never sent to clients.
CAN_CANONICAL_ASSESSMENT_DRAFT_ENABLED=false
# Independent approval roles and publication remain off until separate
# reviewer/publisher NOLOGIN grants and negative authorization QA are proven.
CAN_CANONICAL_ASSESSMENT_REVIEW_ENABLED=false
CAN_CANONICAL_ASSESSMENT_PUBLICATION_ENABLED=false
CAN_NONCREDIT_ASSESSMENT_KEY_HEX=

# Optional canonical survey v1 draft authoring (off until restricted DB role provisioned)
CAN_CANONICAL_SURVEY_DRAFT_ENABLED=false

# Optional restricted canonical survey review/publication (both disabled by default)
CAN_CANONICAL_SURVEY_REVIEW_ENABLED=false
CAN_CANONICAL_SURVEY_PUBLICATION_ENABLED=false

# Trusted Netlify runtime context.ip only; do not use arbitrary client-IP headers.
CAN_SESSION_IP_COLLECTION_ENABLED=0
# 30-day IP and 90-day security-signal retention via the authenticated scheduled job.
CAN_SESSION_DEVICE_RETENTION_ENABLED=0
CAN_JOB_SECRET=
