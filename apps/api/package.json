{
  "name": "@becomuna/api",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test test/http.test.cjs",
    "build:canonical": "node scripts/build-canonical.mjs",
    "sdk:export": "node scripts/export-openapi.cjs",
    "sdk:generate": "npm run build && npm run sdk:export && openapi-typescript sdk/generated/browser-openapi.json -o sdk/generated/schema.ts",
    "sdk:check": "tsc -p sdk/tsconfig.json",
    "sdk:check:workspaces": "tsc -p sdk/tsconfig.workspaces.json",
    "sdk:test": "node --test sdk/transport.test.mjs sdk/engagement-api.test.cjs scripts/browser-sdk-document.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-fastify": "11.2.12",
    "@nestjs/swagger": "11.4.8",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.24.2",
    "openapi-fetch": "0.13.4"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.8.3",
    "openapi-typescript": "7.6.1"
  }
}
