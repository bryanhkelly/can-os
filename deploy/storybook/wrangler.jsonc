// Workers Builds discovery only. Use npm run deploy:storybook:cloudflare from the repository root (or npm --prefix ../.. run deploy:storybook:cloudflare here). Never deploy this discovery file directly.
{
  "name": "becomuna-storybook",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../storybook-static",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
