    { "persona": "guardian", "destination": "/guardian/academics" },
    { "persona": "teacher", "destination": "/classes" },
    { "persona": "registrar", "destination": "/admissions" },
    { "persona": "site_admin", "destination": "/sites" },
    { "persona": "site_leader", "destination": "/staff/attendance" },
    { "persona": "room_facilitator", "destination": "/staff/attendance" },
